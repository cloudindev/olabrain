# =============================================================================
# BrainAgent — variables de entorno
# Copia este fichero a `.env` (nunca lo subas al repo) y rellena los valores.
# Los valores por defecto funcionan con `docker compose up` en local.
# Marcado [F0] = necesario para la Fase 0. [F1+] = se usará en fases siguientes.
# =============================================================================

# -----------------------------------------------------------------------------
# General [F0]
# -----------------------------------------------------------------------------
NODE_ENV=development
# URL pública del panel (Next.js). En local, el puerto por defecto de apps/web.
APP_URL=http://localhost:3000
# Idioma por defecto de la UI (next-intl). Soportados: es, en.
DEFAULT_LOCALE=es

# -----------------------------------------------------------------------------
# PostgreSQL 16 + pgvector [F0]
# docker-compose publica Postgres en el 5433 y Redis en el 6380 para no chocar con
# instalaciones locales (Homebrew) en los puertos estándar.
# Hay dos roles distintos: con un solo rol propietario, RLS no protegería nada.
#  - DATABASE_URL_ADMIN: propietario del esquema. Solo para migraciones y seeds.
#  - DATABASE_URL: rol `brainagent_app`, SIN BYPASSRLS y sin ser propietario.
#    Lo usan la app y los tests. Toda query de negocio pasa por withTenant().
# -----------------------------------------------------------------------------
POSTGRES_USER=brainagent_owner
POSTGRES_PASSWORD=brainagent_owner_dev
POSTGRES_DB=brainagent
DATABASE_URL_ADMIN=postgres://brainagent_owner:brainagent_owner_dev@localhost:5433/brainagent
APP_DB_PASSWORD=brainagent_app_dev
DATABASE_URL=postgres://brainagent_app:brainagent_app_dev@localhost:5433/brainagent

# -----------------------------------------------------------------------------
# Redis (BullMQ) [F0: solo levantado; colas desde F1]
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6380

# -----------------------------------------------------------------------------
# Almacenamiento S3 compatible (MinIO en local) [F0: levantado; uso desde F1]
# -----------------------------------------------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=eu-west-1
S3_BUCKET=brainagent
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
# MinIO necesita path-style; los S3 reales en la UE (OVH, Hetzner) suelen aceptar ambos estilos.
S3_FORCE_PATH_STYLE=true

# -----------------------------------------------------------------------------
# Auth — Better Auth [F0]
# -----------------------------------------------------------------------------
# Genéralo con: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Exige confirmar el email antes de entrar (déjalo en true salvo para tests e2e).
AUTH_REQUIRE_EMAIL_VERIFICATION=true
# Rate limiting de login/registro (3 intentos / 10 s por IP). Solo se desactiva en e2e.
AUTH_RATE_LIMIT=true

# Google OAuth (Google Cloud Console → APIs & Services → Credentials → OAuth client "Web").
# URI de redirección autorizada: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft (Entra ID → App registrations). Cuentas "multitenant + personales".
# Redirect URI (Web): http://localhost:3000/api/auth/callback/microsoft
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# "common" permite cuentas de cualquier organización y cuentas personales.
MICROSOFT_TENANT_ID=common

# Email transaccional (verificación, invitaciones). En local, Mailpit captura todo
# en http://localhost:8025. En producción, un SMTP con sede en la UE.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="BrainAgent <no-reply@brainagent.local>"

# -----------------------------------------------------------------------------
# LiveKit [F0]
# En local se usa el livekit-server de docker-compose (modo --dev, claves fijas).
# En producción: LiveKit Cloud con región de datos UE (agentes en eu-central) o self-host.
# -----------------------------------------------------------------------------
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
# Nombre con el que se registra el worker Python (dispatch explícito desde /lab).
LIVEKIT_AGENT_NAME=brainagent-lab

# -----------------------------------------------------------------------------
# Configuración del spike /lab [F0]
# Valores por defecto; /lab permite cambiarlos por sesión (metadata de la sala).
# Los nombres de modelo y voz van aquí, nunca en el código. Consulta los modelos y
# voces disponibles en la documentación/consola de cada proveedor.
# -----------------------------------------------------------------------------
# pipeline = STT → LLM → TTS | realtime = speech-to-speech (Gemini Live)
LAB_MODE=pipeline
# deepgram
LAB_STT_PROVIDER=deepgram
LAB_STT_MODEL=nova-3
LAB_STT_LANGUAGE=es
# elevenlabs | cartesia
LAB_TTS_PROVIDER=elevenlabs
# Modelo y voz del TTS (ID de voz del proveedor; elige una voz en español de España).
LAB_TTS_MODEL=
LAB_TTS_VOICE_ID=
# google | openai | anthropic  (ruta direct)
LAB_LLM_PROVIDER=google
LAB_LLM_MODEL=
# direct = plugin nativo de LiveKit | litellm = vía proxy LiteLLM (el spike mide la diferencia)
LAB_LLM_ROUTE=direct
# Modelo realtime de Gemini Live (solo LAB_MODE=realtime) y su voz.
LAB_REALTIME_MODEL=
LAB_REALTIME_VOICE=
# Duración máxima de una sesión del laboratorio, en segundos (control de coste).
LAB_MAX_SESSION_SECONDS=600
# Generación anticipada: el LLM empieza antes de confirmar el fin de turno (menos latencia,
# algo más de coste si el usuario sigue hablando). El spike lo mide en ambos valores.
LAB_PREEMPTIVE_GENERATION=true
# Sintetizar también la voz antes de confirmar el turno (más rápido; gasta TTS si el
# usuario sigue hablando).
LAB_PREEMPTIVE_TTS=true
# Silencio mínimo (s) para dar el turno por terminado. LiveKit usa 0.5 por defecto.
LAB_MIN_ENDPOINTING_DELAY=0.3

# -----------------------------------------------------------------------------
# STT: Deepgram [F0]
# Hay endpoint UE (api.eu.deepgram.com) con las mismas claves.
# -----------------------------------------------------------------------------
DEEPGRAM_API_KEY=
# Para el endpoint UE: DEEPGRAM_BASE_URL=https://api.eu.deepgram.com/v1/listen
DEEPGRAM_BASE_URL=

# -----------------------------------------------------------------------------
# TTS: ElevenLabs y Cartesia [F0: al menos una de las dos]
# La residencia de datos en la UE de ElevenLabs (api.eu.residency.elevenlabs.io) es
# Enterprise y usa una clave y un workspace distintos.
# -----------------------------------------------------------------------------
ELEVEN_API_KEY=
CARTESIA_API_KEY=

# -----------------------------------------------------------------------------
# LLM [F0: al menos un proveedor]
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Google: elige UNA opción.
# a) Google AI Studio (rápido para probar; sin garantía de región):
GOOGLE_API_KEY=
# b) Vertex AI en región UE (recomendado para producción):
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=europe-west1
# Ruta absoluta al JSON de la cuenta de servicio (rol "Vertex AI User"). No lo metas en el repo.
GOOGLE_APPLICATION_CREDENTIALS=

# LiteLLM proxy (solo si LAB_LLM_ROUTE=litellm; se levanta con el profile "llm")
LITELLM_BASE_URL=http://localhost:4000
# Genéralo con: openssl rand -hex 24  (debe empezar por "sk-")
LITELLM_MASTER_KEY=sk-

# -----------------------------------------------------------------------------
# Servicio de conectores (apps/connector) [F1]
# Ejecuta las herramientas (MCP, OpenAPI, SQL, HTTP) y guarda las credenciales cifradas.
# -----------------------------------------------------------------------------
CONNECTOR_URL=http://127.0.0.1:4100
# Runtime de chat de texto (apps/agent, chat_server): la web le reenvía las conversaciones.
AGENT_CHAT_URL=http://127.0.0.1:4200
AGENT_CHAT_PORT=4200
CONNECTOR_PORT=4100
# Token que usan la web y el runtime para llamar al conector. Genéralo con: openssl rand -hex 32
CONNECTOR_SERVICE_TOKEN=
# Master key del vault (envuelve la clave AES-256-GCM de cada organización). 32 bytes en base64:
#   openssl rand -base64 32
# En producción vendrá de un KMS. Para rotarla: mueve la actual a *_PREVIOUS y sube la versión.
VAULT_MASTER_KEY=
VAULT_MASTER_KEY_VERSION=1
VAULT_MASTER_KEY_PREVIOUS=
VAULT_MASTER_KEY_PREVIOUS_VERSION=
# Hosts privados a los que se permite salir (anti-SSRF). En local, la BD de demo.
# En producción, déjalo vacío salvo bases de datos on-premise autorizadas.
EGRESS_ALLOWED_PRIVATE_HOSTS=localhost,127.0.0.1

# -----------------------------------------------------------------------------
# Observabilidad [F0: opcional, profile "observability"]
# Langfuse self-host en http://localhost:3001. Crea un proyecto y copia sus claves.
# -----------------------------------------------------------------------------
LANGFUSE_HOST=http://localhost:3001
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Secretos del propio servidor Langfuse (solo producción; en local hay valores de desarrollo).
#   LANGFUSE_SALT / LANGFUSE_NEXTAUTH_SECRET: openssl rand -base64 32
#   LANGFUSE_ENCRYPTION_KEY: openssl rand -hex 32
LANGFUSE_SALT=
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_ENCRYPTION_KEY=
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Nango self-host [F3, profile "connectors"]
# -----------------------------------------------------------------------------
NANGO_SERVER_URL=http://localhost:3003
NANGO_SECRET_KEY=
# Clave de cifrado de Nango (256 bits en base64): openssl rand -base64 32
NANGO_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# Stripe [F4]
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
